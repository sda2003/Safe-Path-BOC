<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:padding="16dp">

    <!-- Drag handle pill at top -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#4A4A4A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Title -->
    <TextView
        android:id="@+id/tv_actions_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Flood — Immediate Actions"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toBottomOf="@id/drag_handle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Red underline -->
    <View
        android:id="@+id/underline"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@color/red_primary"
        app:layout_constraintTop_toBottomOf="@id/tv_actions_title"
        app:layout_constraintStart_toStartOf="@id/tv_actions_title"
        app:layout_constraintEnd_toEndOf="@id/tv_actions_title"
        android:layout_marginTop="4dp"/>

    <!-- RecyclerView of actions -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_actions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/underline"
        app:layout_constraintBottom_toTopOf="@id/btn_reached_shelter"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        tools:listitem="@layout/item_action"/>

    <Button
        android:id="@+id/btn_reached_shelter"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/green_primary"
        android:text="I have reached the shelter"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
