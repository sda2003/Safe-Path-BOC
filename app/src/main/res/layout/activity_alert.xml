<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:padding="24dp">

    <!-- Glowing top badge -->
    <TextView
        android:id="@+id/tv_severity_badge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="20dp"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_alert_glow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- Vector Icon representing Disaster -->
    <ImageView
        android:id="@+id/img_disaster"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/ic_flood"
        app:layout_constraintTop_toBottomOf="@id/tv_severity_badge"
        app:layout_constraintBottom_toTopOf="@id/tv_shelter_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- We keep the original TextViews but hide them or re-purpose them 
         so we don't crash Kotlin code -->
    <TextView
        android:id="@+id/tv_disaster_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Disaster type label (also hidden, as we will combine it in the top badge) -->
    <TextView
        android:id="@+id/tv_disaster_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Shelter name -->
    <TextView
        android:id="@+id/tv_shelter_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/tv_shelter_distance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp" />

    <!-- Shelter distance -->
    <TextView
        android:id="@+id/tv_shelter_distance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="#888888"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/btn_cta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="80dp" />

    <!-- CTA button -->
    <Button
        android:id="@+id/btn_cta"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:text="LEAVE NOW"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#00000000"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:gravity="center"
        android:padding="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp" />

    <View 
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_btn_red"
        app:layout_constraintTop_toTopOf="@id/btn_cta"
        app:layout_constraintBottom_toBottomOf="@id/btn_cta"
        app:layout_constraintStart_toStartOf="@id/btn_cta"
        app:layout_constraintEnd_toEndOf="@id/btn_cta"
        android:elevation="-1dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
