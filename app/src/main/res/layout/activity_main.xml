<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="@color/nav_bar"
        android:gravity="center_vertical"
        android:paddingBottom="6dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/iconHome"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_home"
                android:tint="@color/text_secondary"/>
            <TextView
                android:id="@+id/labelHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:fontFamily="@font/manrope"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <!-- PACK -->
        <LinearLayout
            android:id="@+id/navPack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/iconPack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_pack"
                android:tint="@color/text_secondary"/>
            <TextView
                android:id="@+id/labelPack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pack"
                android:fontFamily="@font/manrope"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <!-- CENTER SPACE FOR FAB -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <!-- SURVIVAL -->
        <LinearLayout
            android:id="@+id/navSurvival"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/iconSurvival"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_survival"
                android:tint="@color/text_secondary"/>
            <TextView
                android:id="@+id/labelSurvival"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Survival"
                android:fontFamily="@font/manrope"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <!-- COMMUNITY -->
        <LinearLayout
            android:id="@+id/navCommunity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/iconCommunity"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_community"
                android:tint="@color/text_secondary"/>
            <TextView
                android:id="@+id/labelCommunity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Community"
                android:fontFamily="@font/manrope"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="3dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- FLOATING ALERT FAB (positioned above bottom nav center) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabReportAlert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:src="@drawable/ic_warning_triangle"
        app:backgroundTint="@color/red_primary"
        app:tint="@color/text_primary"
        app:fabSize="normal"
        app:elevation="8dp"
        app:pressedTranslationZ="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
