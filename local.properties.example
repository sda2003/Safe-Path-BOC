# Copy to local.properties (or use a .env file at project root).
# Never commit real keys.
#
# IMPORTANT: example.supabase.co / placeholder will NOT work.
# Use your real project from https://supabase.com → Project Settings → API

sdk.dir=C\:\\Users\\YOUR_USER\\AppData\\Local\\Android\\Sdk

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_real_anon_key_here
GEMINI_API_KEY=your_gemini_api_key

# Optional: self-hosted OSRM for production (defaults to public demo server)
# OSRM_BASE_URL=https://router.project-osrm.org
